# Copy to .env.local for local development. In production, set these as build-time
# environment variables (Vite inlines them into the bundle, so never put secrets here).

# Endpoint that receives the contact form (POST, JSON: { name, email, message }).
VITE_CONTACT_BASE_URL=https://api.example.com/contact

# Base URL of the chat assistant. The widget calls POST {BASE}/chat and POST {BASE}/clear.
VITE_CHATBOT_BASE_URL=https://api.example.com/chatbot
